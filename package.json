{
  "name": "gravity-camera-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gravity-aware camera pose lab for characters walking on arbitrarily oriented surfaces",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node src/sim/cli.js",
    "sim:all": "node src/sim/cli.js --all --out artifacts",
    "bench": "node bench/pose-bench.mjs",
    "bench:save": "node bench/pose-bench.mjs --save"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.58.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
